local function applySkinById(userId)
    local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
    if ok and desc then
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:ApplyDescription(desc) notify("kemlopHud", "Скин применен!") end)
        end
    else
        notify("Ошибка", "Неверный ID или игрок не найден")
    end
end

