local function getMainFrame()
    -- 1. Прямой поиск по свойствам объекта Window
    local props = {"Main", "Frame", "Window", "Root", "Gui", "MainFrame", "Instance", "Holder", "Container"}
    for _, prop in ipairs(props) do
        local ok, val = pcall(function() return Window[prop] end)
        if ok and typeof(val) == "Instance" and val:IsA("GuiObject") then
            return val
        end
    end

    -- 2. Поиск через ScreenGui по заголовку "kemlopHud"
    local screens = {}
    local function scan(parent)
        for _, v in pairs(parent:GetChildren()) do
            if v:IsA("ScreenGui") and v.Enabled then
                -- Ищем текст "kemlopHud" внутри
                for _, d in pairs(v:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Text and d.Text:lower():find("kemlophud") then
                        table.insert(screens, v)
                        break
                    end
                end
            elseif v:IsA("Folder") then
                scan(v) -- Рекурсивно проверяем папки
            end
        end
    end

    if gethui then scan(gethui()) end
    scan(game:GetService("CoreGui"))
    scan(LocalPlayer:WaitForChild("PlayerGui"))

    if #screens > 0 then
        local screen = screens[1]
        -- Находим самый большой Frame внутри этого ScreenGui
        local bestFrame, maxArea = nil, 0
        for _, obj in pairs(screen:GetDescendants()) do
            if (obj:IsA("Frame") or obj:IsA("CanvasGroup")) and obj.Visible then
                local area = obj.AbsoluteSize.X * obj.AbsoluteSize.Y
                if area > maxArea and obj.AbsoluteSize.X > 300 and obj.AbsoluteSize.Y > 200 then
                    maxArea = area
                    bestFrame = obj
                end
            end
        end
        if bestFrame then return bestFrame end
    end

    -- 3. Запасной вариант: ищем просто самый большой Frame в CoreGui
    local fallbackFrame, maxArea = nil, 0
    local function scanAll(parent)
        for _, v in pairs(parent:GetChildren()) do
            if v:IsA("ScreenGui") and v.Enabled then
                for _, obj in pairs(v:GetDescendants()) do
                    if (obj:IsA("Frame") or obj:IsA("CanvasGroup")) and obj.Visible then
                        local area = obj.AbsoluteSize.X * obj.AbsoluteSize.Y
                        if area > maxArea and obj.AbsoluteSize.X > 400 and obj.AbsoluteSize.X < 1000 and obj.AbsoluteSize.Y > 300 then
                            maxArea = area
                            fallbackFrame = obj
                        end
                    end
                end
            elseif v:IsA("Folder") then
                scanAll(v)
            end
        end
    end

    if gethui then scanAll(gethui()) end
    scanAll(game:GetService("CoreGui"))
    
    return fallbackFrame
end

local function applyForceBackground(imageId)
    local mainFrame = getMainFrame()
    if not mainFrame then return "Ошибка: Окно не найдено" end

    -- Удаляем старый фон, если есть
    local old = mainFrame:FindFirstChild("ForceBG")
    if old then old:Destroy() end

    -- Создаем новый фон
    local bg = Instance.new("ImageLabel")
    bg.Name = "ForceBG"
    bg.Size = UDim2.fromScale(1, 1)
    bg.Position = UDim2.fromScale(0, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.Image = "rbxassetid://" .. imageId
    bg.ImageTransparency = 0.3
    bg.ScaleType = Enum.ScaleType.Crop
    bg.ZIndex = 0
    bg.Parent = mainFrame

    -- Делаем фон окна прозрачным (чтобы не было черного квадрата)
    mainFrame.BackgroundTransparency = 1
    mainFrame.ClipsDescendants = true

    -- Поднимаем элементы интерфейса выше фона
    for _, obj in ipairs(mainFrame:GetDescendants()) do
        if obj:IsA("GuiObject") and obj ~= bg and not obj:IsDescendantOf(bg) then
            if obj.ZIndex <= 0 then
                obj.ZIndex = 1
            end
        end
    end

    return "Успешно применено!"
end

