-- ПЕРЕМЕННЫЕ
-- ============================================================
local FarmEnabled, ESPEnabled, AuraEnabled = false, false, false
local AimEnabled, AutoShootEnabled, BlockMurdererEnabled = false, false, false
local AimSmoothness = 0.2
local FlySpeed, MaxCoins = 150, 40
local ESPObjects = {}
local currentTargetCoin = nil
local lastBlockTime = 0

-- ============================================================
-- 🐱 ФАРМ (Плавный полет)
-- ============================================================
local function getNearestCoin()
    local hrp = getHRP(); if not hrp then return nil end
    local nearest, shortest = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < shortest then shortest = d; nearest = obj end
        end
    end
    return nearest
end

RunService.RenderStepped:Connect(function(dt)
    if FarmEnabled and currentTargetCoin and currentTargetCoin.Parent then
        local hrp, hum = getHRP(), getHum()
        if hrp and hum then
            hum.PlatformStand = true
            for _, p in ipairs(getChar():GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
            local currentPos = hrp.Position
            local targetPos = currentTargetCoin.Position
            if (targetPos - currentPos).Magnitude > 2 then
                local moveDir = (targetPos - currentPos).Unit
                local newPos = currentPos + moveDir * FlySpeed * dt
                hrp.CFrame = CFrame.lookAt(newPos, targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end
    end
end)

local function startFarm()
    if FarmEnabled then return end
    FarmEnabled = true
    task.spawn(function()
        local coins = 0
        while FarmEnabled do
            currentTargetCoin = getNearestCoin()
            if currentTargetCoin then
                while FarmEnabled and currentTargetCoin and currentTargetCoin.Parent do
                    local hrp = getHRP()
                    if hrp and (currentTargetCoin.Position - hrp.Position).Magnitude < 3 then break end
                    task.wait(0.05)
                end
                coins = coins + 1
                if coins >= MaxCoins then
                    notify("🐱 Фарм", "Респавн...")
                    local h = getHum(); if h then h.Health = 0 end
                    break
                end
                task.wait(0.1)
            else
                task.wait(0.5)
            end
        end
        FarmEnabled = false; currentTargetCoin = nil
        local h = getHum(); if h then h.PlatformStand = false end
    end)
end

local function stopFarm()
    FarmEnabled = false; currentTargetCoin = nil
    local h = getHum(); if h then h.PlatformStand = false end
end

-- ============================================================
-- 🎯 АИМ И АВТО-СТРЕЛЬБА
-- ============================================================
task.spawn(function()
    while task.wait(0.05) do
        if AimEnabled then
            local target = getMurderer()
            if target and target.Character then
                local head = target.Character:FindFirstChild("Head")
                if head then
                    local cam = Workspace.CurrentCamera
                    local targetCFrame = CFrame.new(cam.CFrame.Position, head.Position)
                    cam.CFrame = cam.CFrame:Lerp(targetCFrame, AimSmoothness)
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        local target = getMurderer()
        local myHrp = getHRP()
        local char = getChar()

        if target and target.Character and myHrp and char then
            local tHead = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")

            if AutoShootEnabled and tHead then
                local gun = char:FindFirstChild("Gun")
                if gun and (tHead.Position - myHrp.Position).Magnitude < 100 then
                    pcall(function() gun:Activate() end)
                end
            end

            if BlockMurdererEnabled and tHead then
                local dist = (tHead.Position - myHrp.Position).Magnitude
                if dist < 12 and (tick() - lastBlockTime > 1) then
                    myHrp.CFrame = myHrp.CFrame + Vector3.new(0, 20, 0)
                    lastBlockTime = tick()
                    notify("🛡 Блок", "Уклонение от удара!")
                end
            end
        end
    end
end)

-- ============================================================
-- 👁 ESP И АУРА
-- ============================================================
local function applyESP(p)
    if not ESPEnabled or p == LocalPlayer or not p.Character then return end
    local role = getRole(p)
    local color = Color3.fromRGB(0, 255, 0)
    if role == "Murderer" then color = Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then color = Color3.fromRGB(0, 150, 255) end

    if ESPObjects[p] then ESPObjects[p]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Adornee = p.Character
    hl.FillColor = color
    hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Parent = p.Character
    ESPObjects[p] = hl
end

local function refreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if ESPEnabled then applyESP(p) else
                if ESPObjects[p] then ESPObjects[p]:Destroy(); ESPObjects[p] = nil end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        if AuraEnabled and getRole(LocalPlayer) == "Murderer" then
            local char = getChar()
            local knife = char and char:FindFirstChild("Knife")
            if knife then
                local hrp = getHRP()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if tHrp and hrp and (tHrp.Position - hrp.Position).Magnitude < 15 then
                            pcall(function() knife:Activate() end)
                        end
                    end
                end
            end
        end
    end
end)

