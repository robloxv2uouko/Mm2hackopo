local flyAP, flyAO, flyAtt, flyVelo = nil, nil, nil, Vector3.zero
RS.RenderStepped:Connect(function(dt)
    if not S.Fly then if flyAP then flyAP:Destroy() flyAO:Destroy() flyAtt:Destroy() flyAP = nil local h = gh() if h then h.PlatformStand = false end end return end
    local r, h = gr(), gh()
    if not r or not h then return end
    h.PlatformStand = true
    if not flyAP then
        flyAtt = Instance.new("Attachment", r)
        flyAP = Instance.new("AlignPosition", r)
        flyAP.Mode = Enum.PositionAlignmentMode.OneAttachment
        flyAP.Attachment0 = flyAtt flyAP.MaxForce = 1e9 flyAP.Responsiveness = 30
        flyAP.Position = r.Position
        flyAO = Instance.new("AlignOrientation", r)
        flyAO.Mode = Enum.OrientationAlignmentMode.OneAttachment
        flyAO.Attachment0 = flyAtt flyAO.MaxTorque = 1e9 flyAO.Responsiveness = 25
        flyAO.CFrame = r.CFrame
    end
    local dir = Vector3.zero
    local mv = h.MoveDirection
    if mv.Magnitude > 0.05 then
        local lv = cam.CFrame:VectorToObjectSpace(mv)
        dir = cam.CFrame.LookVector * (-lv.Z) + cam.CFrame.RightVector * lv.X
    end
    if h.Jump then dir += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
    if dir.Magnitude > 1 then dir = dir.Unit end
    flyVelo = flyVelo:Lerp(dir * S.FlySpd, math.clamp(dt * 6, 0, 1))
    flyAP.Position = r.Position + flyVelo * dt * 10
    flyAO.CFrame = CFrame.new(r.Position, r.Position + cam.CFrame.LookVector)
end)
