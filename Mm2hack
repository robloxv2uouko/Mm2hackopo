local coinList,lastScan={},0
local function isCoin(o) return o:IsA("BasePart") and o.Name:lower()=="coin_server" end
loop(0.5,function()
    if not(S.Farm or S.CoinESP) then return end
    local l,found={},false
    for _,m in ipairs(workspace:GetChildren()) do
        local cc=m:FindFirstChild("CoinContainer")
        if cc then
            found=true
            for _,o in ipairs(cc:GetDescendants()) do if isCoin(o) then l[#l+1]=o end end
            break
        end
    end
    if not found then
        if tick()-lastScan<5 then return end
        lastScan=tick()
        for _,o in ipairs(workspace:GetDescendants()) do if isCoin(o) then l[#l+1]=o end end
    end
    coinList=l
end)
local function isFresh(c) return c.Parent and c:FindFirstChildWhichIsA("TouchTransmitter")~=nil end
local function inLobby()
    local r=gr() if not r then return true end
    local lobby=workspace:FindFirstChild("Lobby")
    if lobby and lobby:IsA("Model") then
        local ok,cf,size=pcall(function() return lobby:GetBoundingBox() end)
        if ok and cf then
            local rel=cf:PointToObjectSpace(r.Position)
            if math.abs(rel.X)<=size.X/2+5 and math.abs(rel.Y)<=size.Y/2+30 and math.abs(rel.Z)<=size.Z/2+5 then return true end
        end
    end
    return false
end

local visited,curCoin,holdBV,below={},nil,nil,false
local function pick()
    local r=gr() if not r then return end
    local now,anyF=tick(),false
    for _,c in ipairs(coinList) do if isFresh(c) then anyF=true break end end
    local best,bd
    for _,c in ipairs(coinList) do
        if c.Parent and not(visited[c] and now-visited[c]<2.5) and ((not anyF) or isFresh(c)) then
            local d=(c.Position-r.Position).Magnitude
            if d<=S.Dist and (not bd or d<bd) then best,bd=c,d end
        end
    end
    return best
end
local function stopHold()
    local r=gr()
    if holdBV then holdBV:Destroy() holdBV=nil end
    local h=gh()
    if h and not S.Fly then h.PlatformStand=false end
    if below and r then r.CFrame=r.CFrame+Vector3.new(0,S.Depth+4,0) r.AssemblyLinearVelocity=Vector3.zero end
    below,curCoin=false,nil
end

hb(function(dt)
    if not S.Farm then if holdBV or below then stopHold() end return end
    if dying then return end
    local r,h=gr(),gh()
    if not(r and h) or h.Health<=0 then return end
    if inLobby() then if holdBV or below then stopHold() end return end
    if S.Pause and getRole(lp)~="Murderer" then
        local m=byRole("Murderer")
        local mr=m and rootOf(m)
        if mr and (mr.Position-r.Position).Magnitude<25 then r.AssemblyLinearVelocity=Vector3.zero return end
    end
    if not(curCoin and curCoin.Parent and isFresh(curCoin)) then
        curCoin=pick()
        if not curCoin then if holdBV or below then stopHold() end return end
    end
    if not holdBV or holdBV.Parent~=r then
        if holdBV then holdBV:Destroy() end
        holdBV=Instance.new("BodyVelocity")
        holdBV.MaxForce=Vector3.new(1e9,1e9,1e9) holdBV.Velocity=Vector3.zero holdBV.Parent=r
    end
    h.PlatformStand=true below=true
    local target=curCoin.Position-Vector3.new(0,S.Depth,0)
    local delta=target-r.Position
    local step=S.Speed*dt
    if delta.Magnitude<=step+0.5 then
        local coin=curCoin
        r.CFrame=CFrame.new(target)
        if firetouchinterest then touch(r,coin) else r.CFrame=coin.CFrame end
        visited[coin]=tick() curCoin=nil
        task.delay(0.5,function()
            if dying then return end
            if (not coin.Parent) or (not isFresh(coin)) then
                count+=1
                if S.AutoDie and count>=S.Limit then
                    dying=true
                    notify("kemlopHud","Лимит "..count.." монет, умираю")
                    stopHold() local hh=gh() if hh then hh.Health=0 end
                end
            end
        end)
    else
        r.CFrame=CFrame.new(r.Position+delta.Unit*step)
    end
    r.AssemblyLinearVelocity=Vector3.zero r.AssemblyAngularVelocity=Vector3.zero
end)

