local holdBV
local function stopPhysics()
    if holdBV then holdBV:Destroy() holdBV = nil end
    local h = gh()
    if h then h.PlatformStand = false end
end
local function startPhysics()
    local r = gr()
    if r and not holdBV then
        holdBV = Instance.new("BodyVelocity")
        holdBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        holdBV.Velocity = Vector3.zero
        holdBV.Parent = r
    end
end

hb(function(dt)
    if not S.Farm then if holdBV then stopPhysics() end return end
    local r, h = gr(), gh()
    if not r or not h or h.Health <= 0 then return end
    local best, dist = nil, math.huge
    for _, c in ipairs(coins) do
        if c.Parent then
            local d = (c.Position - r.Position).Magnitude
            if d < dist then best, dist = c, d end
        end
    end
    if best then
        h.PlatformStand = true startPhysics()
        local targetPos = best.Position + Vector3.new(0, 0, S.ZOffset)
        local moveDir = (targetPos - r.Position).Unit
        local step = math.min(S.FarmSpeed * dt, dist)
        local newPos = r.Position + moveDir * step
        local baseLook = CFrame.lookAt(newPos, targetPos)
        local diveCF = baseLook * CFrame.Angles(math.rad(-90), 0, 0)
        local smoothRot = r.CFrame.Rotation:Lerp(diveCF.Rotation, math.clamp(dt * 10, 0, 1))
        r.CFrame = CFrame.new(newPos) * smoothRot
        if dist <= 5 then
            touchPart(r, best) count += 1
            if count >= S.Limit and S.AutoDie then
                h.Health = 0 count = 0 stopPhysics()
            end
        end
    else stopPhysics() end
end)

