local BG_DEFAULT = "rbxassetid://100780772234967"
local BG_CAT = "rbxassetid://116530036450269"
local bgImgCache = nil
local function findBgImage()
    if bgImgCache and bgImgCache.Parent then return bgImgCache end
    local sg = guiParent():FindFirstChild("WindUI")
    if not sg then return nil end
    local main = sg:FindFirstChild("MainFrame")
    if not main then
        for _, v in ipairs(sg:GetDescendants()) do
            if v:IsA("Frame") and v.AbsoluteSize.X > 400 and v.AbsoluteSize.Y > 300 then main = v break end
        end
    end
    if not main then return nil end
    for _, v in ipairs(main:GetDescendants()) do
        if v:IsA("ImageLabel") and (v.Image == BG_DEFAULT or v.Image == BG_CAT) then bgImgCache = v return v end
    end
    for _, v in ipairs(main:GetDescendants()) do
        if v:IsA("Frame") and (v.BackgroundImage == BG_DEFAULT or v.BackgroundImage == BG_CAT) then bgImgCache = v return v end
    end
    return nil
end
local function applyBgImage()
    local id = S.CatBg and BG_CAT or BG_DEFAULT
    local img = findBgImage()
    if img then
        if img:IsA("Frame") then img.BackgroundImage = id else img.Image = id end
        return
    end
    task.spawn(function()
        for _ = 1, 40 do
            task.wait(0.25)
            local i = findBgImage()
            if i then
                if i:IsA("Frame") then i.BackgroundImage = id else i.Image = id end
                return
            end
        end
    end)
end
