local flyAP,flyAO,flyAtt,flyVelo,flyTrack,flyKind=nil,nil,nil,Vector3.zero,nil,nil
local FLY_ANIMS={stand="507766666",hero="616108001"}
local function stopFlyAnim()
    if flyTrack then pcall(function() flyTrack:Stop(0.2) end) end
    flyTrack,flyKind=nil,nil
end
local function playFlyAnim(kind)
    if flyKind==kind then return end
    stopFlyAnim()
    if not S.FlyAnim then return end
    local h=gh()
    local an=h and h:FindFirstChildOfClass("Animator")
    if not an then return end
    local a=Instance.new("Animation")
    a.AnimationId="rbxassetid://"..FLY_ANIMS[kind]
    local ok,tr=pcall(function() return an:LoadAnimation(a) end)
    if ok and tr then
        tr.Priority=Enum.AnimationPriority.Action4
        tr.Looped=true
        tr:Play(0.25)
        flyTrack,flyKind=tr,kind
    end
end

-- эффекты полёта: красный плащ и след (видишь только ты)
local fxCape,fxWeld,fxTrail,fxA0,fxA1,fxTopY,fxZ=nil,nil,nil,nil,nil,0.8,0.55
local function clearFx()
    for _,o in ipairs({fxCape,fxTrail,fxA0,fxA1}) do if o then pcall(function() o:Destroy() end) end end
    fxCape,fxWeld,fxTrail,fxA0,fxA1=nil,nil,nil,nil,nil
end
local function makeFx(c,r)
    clearFx()
    local torso=c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
    if torso then
        fxTopY=torso.Size.Y/2
        fxZ=torso.Size.Z/2+0.05
        fxCape=Instance.new("Part")
        fxCape.Name="kemlopCape" fxCape.Size=Vector3.new(2.2,3.4,0.08)
        fxCape.Color=Color3.fromRGB(175,20,28) fxCape.Material=Enum.Material.Fabric
        fxCape.CanCollide=false fxCape.CanQuery=false fxCape.CanTouch=false fxCape.Massless=true
        fxCape.Parent=c
        fxWeld=Instance.new("Weld") fxWeld.Part0=torso fxWeld.Part1=fxCape
        fxWeld.C0=CFrame.new(0,fxTopY,fxZ)*CFrame.new(0,-1.7,0)
        fxWeld.Parent=fxCape
    end
    fxA0=Instance.new("Attachment") fxA0.Position=Vector3.new(0,0.9,0.6) fxA0.Parent=r
    fxA1=Instance.new("Attachment") fxA1.Position=Vector3.new(0,-0.9,0.6) fxA1.Parent=r
    fxTrail=Instance.new("Trail")
    fxTrail.Attachment0=fxA0 fxTrail.Attachment1=fxA1 fxTrail.Lifetime=0.5
    fxTrail.Color=ColorSequence.new(Color3.fromRGB(255,70,60),Color3.fromRGB(255,255,255))
    fxTrail.Transparency=NumberSequence.new(0.25,1)
    fxTrail.LightEmission=0.6 fxTrail.Enabled=false fxTrail.Parent=r
end
local function updateFx(ratio)
    if fxWeld and fxCape and fxCape.Parent then
        local ang=-(6+62*ratio)-math.sin(tick()*14)*5*ratio
        fxWeld.C0=CFrame.new(0,fxTopY,fxZ)*CFrame.Angles(math.rad(ang),0,0)*CFrame.new(0,-1.7,0)
    end
    if fxTrail then fxTrail.Enabled=ratio>0.35 end
end

local function flyCleanup()
    if flyAP then flyAP:Destroy() end
    if flyAO then flyAO:Destroy() end
    if flyAtt then flyAtt:Destroy() end
    flyAP,flyAO,flyAtt,flyVelo=nil,nil,nil,Vector3.zero
    stopFlyAnim()
    clearFx()
    local h=gh() if h and not S.Farm then h.PlatformStand=false end
end
RS.RenderStepped:Connect(function(dt)
    pcall(function()
        if (not S.Fly) or S.Farm then
            if flyAP then flyCleanup() end
            return
        end
        local r,c=gr() local h=gh()
        if not(r and h and c) then return end
        h.PlatformStand=true
        if not(flyAP and flyAP.Parent) then
            if flyAP then flyCleanup() h.PlatformStand=true end
            flyAtt=Instance.new("Attachment") flyAtt.Name="FlyAtt" flyAtt.Parent=r
            flyAP=Instance.new("AlignPosition")
            flyAP.Mode=Enum.PositionAlignmentMode.OneAttachment
            flyAP.Attachment0=flyAtt flyAP.MaxForce=1e9 flyAP.Responsiveness=30
            flyAP.Position=r.Position flyAP.Parent=r
            flyAO=Instance.new("AlignOrientation")
            flyAO.Mode=Enum.OrientationAlignmentMode.OneAttachment
            flyAO.Attachment0=flyAtt flyAO.MaxTorque=1e9 flyAO.Responsiveness=25
            flyAO.CFrame=r.CFrame flyAO.Parent=r
        end
        if S.FlyFx then
            if not(fxTrail and fxTrail.Parent) then makeFx(c,r) end
        elseif fxTrail or fxCape then
            clearFx()
        end
        local camCF=cam.CFrame
        local dir=Vector3.zero
        local mv=h.MoveDirection
        if mv.Magnitude>0.05 then
            local lv=camCF:VectorToObjectSpace(mv)
            dir=camCF.LookVector*(-lv.Z)+camCF.RightVector*lv.X
        end
        if h.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir-=Vector3.new(0,1,0) end
        if dir.Magnitude>1 then dir=dir.Unit end
        flyVelo=flyVelo:Lerp(dir*S.FlySpd,math.clamp(dt*6,0,1))

        local ratio=math.clamp(flyVelo.Magnitude/math.max(S.FlySpd,1),0,1)
        local pose=S.Pose
        local f
        if pose=="Супермен" then f=1
        elseif pose=="Стоя" then f=0.15*ratio
        else f=0.85*math.clamp((ratio-0.1)/0.45,0,1) end -- Хоумлендер: завис стоя, в разгоне наклон вперёд
        local kind="stand"
        if pose=="Супермен" or (pos
