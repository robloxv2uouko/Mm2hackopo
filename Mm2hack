local function getRole(p)
    local roleAttr = p:GetAttribute("Role") or p:GetAttribute("role")
    if roleAttr then
        roleAttr = tostring(roleAttr):lower()
        if roleAttr:find("murder") then return "Murderer" end
        if roleAttr:find("sheriff") or roleAttr:find("hero") then return "Sheriff" end
    end
    local function checkTools(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("knife") then return "Murderer" end
                if n:find("gun") or n:find("revolver") then return "Sheriff" end
            end
        end
        return nil
    end
    return checkTools(p.Character) or checkTools(p:FindFirstChildOfClass("Backpack")) or "Innocent"
end

