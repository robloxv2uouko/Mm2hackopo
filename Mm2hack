local function bypassHydroHub()
    getgenv().HydroHub = true
    getgenv().Bypassed = true
    getgenv().Executor = "Synapse X"
    if hookfunction and identifyexecutor then
        pcall(function()
            hookfunction(identifyexecutor, function() return "Synapse X", "1.0.0" end)
        end)
    elseif identifyexecutor then
        pcall(function()
            identifyexecutor = function() return "Synapse X", "1.0.0" end
        end)
    end
    notify("kemlopHud", "Обход Hydro Hub активирован")
end

local function loadHydroHub()
    bypassHydroHub()
    local hydroURL = "https://raw.githubusercontent.com/FRX397/Hydrohub/main/Hydro_hub"
    local src = httpGet(hydroURL)
    if not src then
        notify("kemlopHud", "Ошибка: Не удалось скачать Hydro Hub (проверь ссылку)")
        return
    end
    local ok, err = pcall(function() loadstring(src)() end)
    if not ok then
        notify("kemlopHud", "Ошибка запуска Hydro Hub: " .. tostring(err))
    else
        notify("kemlopHud", "Hydro Hub успешно загружен!")
    end
end

TabMisc:Button({
    Title = "Загрузить Hydro Hub",
    Desc = "С обходом блокировки исполнителя",
    Callback = function() loadHydroHub() end,
})

