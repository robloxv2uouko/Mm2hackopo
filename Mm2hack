local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    if syn and syn.request then local o, r = pcall(function() return syn.request({Url = url, Method = "GET"}).Body end) if o and r then return r end end
    if request then local o, r = pcall(function() return request({Url = url, Method = "GET"}).Body end) if o and r then return r end end
    return nil
end

