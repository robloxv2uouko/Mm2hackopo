local function getChar() return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() end
local function getHRP() local c = getChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar(); return c and c:FindFirstChildOfClass("Humanoid") end

local FarmEnabled, ESPEnabled, AuraEnabled = false, false, false
local TweenSpeed, MaxCoins = 0.4, 40
local ESPObjects = {}

-- ============================================================
-- 🐱 ЯДРО АВТОФАРМА (Smooth Fly Style)
-- ============================================================
local function getNearestCoin()
    local hrp = getHRP(); if not hrp then return nil end
    local nearest, shortest = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < shortest then shortest = d; nearest = obj end
        end
    end
    return nearest
end

local function startFarm()
    FarmEnabled = true
    task.spawn(function()
        local coins = 0
        while FarmEnabled do
            local coin = getNearestCoin()
            local hrp, hum = getHRP(), getHum()
            if coin and hrp and hum then
                hum.PlatformStand = true
                for _, p in ipairs(getChar():GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
                local tween = TweenService:Create(hrp, TweenInfo.new(TweenSpeed, Enum.EasingStyle.Linear), {CFrame = coin.CFrame + Vector3.new(0, 2, 0)})
                tween:Play(); tween.Completed:Wait()
                coins = coins + 1
                if coins >= MaxCoins then
                    hum.Health = 0
                    FarmEnabled = false
                    WindUI:Notify({Title="🐱 Фарм", Content="Смерть для респавна...", Duration=3})
                    break
                end
            else
                task.wait(0.2)
            end
        end
        local hum = getHum(); if hum then hum.PlatformStand = false end
    end)
end

-- ============================================================
-- 👁 ЯДРО ESP (Highlight Style)
-- ============================================================
local function getRole(p)
    local c, b = p.Character, p:FindFirstChild("Backpack")
    if not c then return "Innocent" end
    if c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife")) then return "Murderer"
    elseif c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun")) then return "Sheriff"
    else return "Innocent" end
end

local function applyESP(p)
    if not ESPEnabled or p == LocalPlayer or not p.Character then return end
    local role = getRole(p)
    local color = Color3.fromRGB(0, 255, 0)
    if role == "Murderer" then color = Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then color = Color3.fromRGB(0, 150, 255) end
    if ESPObjects[p] then ESPObjects[p]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Adornee = p.Character
    hl.FillColor = color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
    hl.Parent = p.Character
    ESPObjects[p] = hl
end

local function refreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if ESPEnabled then applyESP(p) else
                if ESPObjects[p] then ESPObjects[p]:Destroy(); ESPObjects[p] = nil end
            end
        end
    end
end

