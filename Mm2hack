local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    if syn and syn.request then
        local ok2, r = pcall(function() return syn.request({Url = url, Method = "GET"}).Body end)
        if ok2 and type(r) == "string" then return r end
    end
    if request then
        local ok3, r = pcall(function() return request({Url = url, Method = "GET"}).Body end)
        if ok3 and type(r) == "string" then return r end
    end
    if http and http.request then
        local ok4, r = pcall(function() return http.request({Url = url, Method = "GET"}).Body end)
        if ok4 and type(r) == "string" then return r end
    end
    return nil
end

