local roles, RF = {}, nil
loop(2, function()
    if not RF or not RF.Parent then RF = RepStorage:FindFirstChild("GetPlayerData", true) end
    if RF and RF:IsA("RemoteFunction") then
        local ok, data = pcall(function() return RF:InvokeServer() end)
        if ok and type(data) == "table" then
            local c = {}
            for n, i in pairs(data) do if type(i) == "table" and type(i.Role) == "string" then c[n] = i.Role end end
            roles = c
        end
    end
end)
local function getRole(p)
    local r = roles[p.Name]
    if r then
        r = r:lower()
        if r:find("murder") then return "Murderer" end
        if r:find("sheriff") or r:find("hero") then return "Sheriff" end
        return "Innocent"
    end
    return "Innocent"
end

