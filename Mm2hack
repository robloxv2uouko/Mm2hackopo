local MaxDistance = 150
local MaxCoins = 50 
local DieAfterFarm = false 

local ESPObjects = {}
local FlyBV, FlyBG = nil, nil
local NoclipWasActive = false
local ignoredCoins = {}

-- ============================================================
-- ХЕЛПЕРЫ
-- ============================================================
local function getHRP()  local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum()  local c = LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end

local function getRole(p)
    local c, b = p.Character, p:FindFirstChild("Backpack")
    if not c then return "Innocent" end
    if c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife")) then return "Murderer"
    elseif c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun")) then return "Sheriff"
    else return "Innocent" end
end

-- ============================================================
-- УМНЫЙ ФАРМ (СУПЕРМЕН)
-- ============================================================
local function getNearestCoin()
    local hrp = getHRP(); if not hrp then return nil end
    local nearest, shortest = nil, math.huge
    local now = tick()
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and obj.Parent then
            if not ignoredCoins[obj] or ignoredCoins[obj] < now then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < shortest then shortest = d; nearest = obj end
            end
        end
    end
    return nearest
end

local function startFarm()
    FarmEnabled = true
    task.spawn(function()
        local coins = 0
        while FarmEnabled do
            local coin = getNearestCoin()
            local hrp, hum = getHRP(), getHum()
            
            if coin and hrp and hum then
                local dist = (coin.Position - hrp.Position).Magnitude
                
                if dist > MaxDistance then
                    task.wait(0.5) 
                else
                    hum.PlatformStand = true
                    
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.P = 10000
                    bv.Parent = hrp
                    
                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bg.P = 10000; bg.D = 100
                    bg.Parent = hrp
                    
                    local startTime = tick()
                    while FarmEnabled and coin and coin.Parent and (hrp.Position - coin.Position).Magnitude > 3 and tick() - startTime < 3 do
                        if not coin or not coin.Parent then break end
                        local dir = (coin.Position - hrp.Position).Unit
                        bv.Velocity = dir * FarmSpeed
                        
                        local lookCF = CFrame.lookAt(hrp.Position, hrp.Position + dir)
                        bg.CFrame = lookCF * CFrame.Angles(math.rad(-90), 0, 0)
                        
                        RunService.Heartbeat:Wait()
                    end
                    
                    bv:Destroy()
                    bg:Destroy()
                    hrp.Velocity = Vector3.zero
                    
                    if not coin or not coin.Parent then
                        coins += 1
                        WindUI:Notify({ Title="🐱 Фарм", Content="Собрано: " .. coins, Duration=1 })
                        if DieAfterFarm and coins >= MaxCoins then
                            hum.Health = 0
                            FarmEnabled = false
                            break
                        end
                        task.wait(0.1)
                    else
                        ignoredCoins[coin] = tick() + 5
                        task.wait(0.1)
                    end
                end
            else
                task.wait(0.5)
            end
        end
        
        local h = getHum()
        if h then h.PlatformStand = false; h:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end

-- ============================================================
-- FLY
-- ============================================================
local function toggleFly(state)
    FlyEnabled = state
    if FlyEnabled and FarmEnabled then
        FarmEnabled = false
    end
    
    local hrp = getHRP()
    if FlyEnabled and hrp then
        FlyBV = Instance.new("BodyVelocity"); FlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge); FlyBV.Velocity = Vector3.zero; FlyBV.Parent = hrp
        FlyBG = Instance.new("BodyGyro"); FlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); FlyBG.P = 1000; FlyBG.D = 50; FlyBG.Parent = hrp
    else
        if FlyBV then FlyBV:Destroy(); FlyBV = nil end
        if FlyBG then FlyBG:Destroy(); FlyBG = nil end
    end
end

RunService.RenderStepped:Connect(function()
    if FlyEnabled then
        local hrp = getHRP(); local hum = getHum()
        if hrp and hum and FlyBV and FlyBG then
            local cam = Workspace.CurrentCamera
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                local flyVector = (cam.CFrame.LookVector * moveDir.Z) + (cam.CFrame.RightVector * moveDir.X)
                FlyBV.Velocity = flyVector * FlySpeed
            else
                FlyBV.Velocity = Vector3.zero
            end
            FlyBG.CFrame = cam.CFrame
        end
    end
end)

-- ============================================================
-- ESP, АУРА, NOCLIP, FLING
-- ============================================================
local function applyESP(p)
    if not ESPEnabled or p == LocalPlayer or not p.Character then return end
    local role = getRole(p)
    local color = Color3.fromRGB(0, 255, 0)
    if role == "Murderer" then color = Color3.fromRGB(255, 60, 60)
    elseif role == "Sheriff" then color = Color3.fromRGB(60, 160, 255) end
    if ESPObjects[p] then ESPObjects[p]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Adornee = p.Character; hl.FillColor = color; hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
    hl.Parent = p.Character; ESPObjects[p] = hl
end

local function clearESP()
    for p, h in pairs(ESPObjects) do if h then h:Destroy() end ESPObjects[p] = nil end
end

task.spawn(function()
    while task.wait(1) do
        if ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then applyESP(p) end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.15) do
        if AuraEnabled and getRole(LocalPlayer) == "Murderer" then
            local char = LocalPlayer.Character; local knife = char and char:FindFirstChild("Knife"); local hrp = getHRP()
            if knife and hrp then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if tHrp and (tHrp.Position - hrp.Position).Magnitude < 15 then pcall(function() knife:Activate() end) end
                    end
                end
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    local c = LocalPlayer.Character
    if not c then return end
    
    if NoclipEnabled then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
        NoclipWasActive = true
    else
        if NoclipWasActive then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    if p.Name == "HumanoidRootPart" then p.CanCollide = false
                    else p.CanCollide = true end
                end
            end
            NoclipWasActive = false
        end
    end

    if RainbowEnabled then
        local hue = tick() % 1
        for _, p in ipairs(c:GetChildren()) do if p:IsA("BasePart") then p.Color = Color3.fromHSV(hue, 1, 1) end end
    end
    if AutoJumpEnabled then
        local hum = c:FindFirstChildOfClass("Humanoid"); if hum then hum.Jump = true end
    end
end)

RunService.Heartbeat:Connect(function()
    if FlingEnabled then
        local hrp = getHRP()
        if hrp then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if tHrp and (tHrp.Position - hrp.Position).Magnitude <= FlingRange then
                        tHrp.Velocity = Vector3.new(50000, 50000, 50000)
                        task.wait(0.1)
                        if tHrp and tHrp.Parent then tHrp.Velocity = Vector3.new(0, 0, 0) end
                    end
                end
            end
        end
    end
end)

