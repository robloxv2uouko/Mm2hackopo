local function getTarget()
    local closest = nil local shortest = S.AimRange or 300
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local role = getRole(p) local valid = false
                if S.AimTarget == "Все" then valid = true
                elseif S.AimTarget == "Убийца" and role == "Murderer" then valid = true
                elseif S.AimTarget == "Шериф" and role == "Sheriff" then valid = true end
                if valid then
                    local _, onScreen = camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local dist = (p.Character.HumanoidRootPart.Position - camera.CFrame.Position).Magnitude
                        if dist < shortest then shortest = dist closest = p.Character.HumanoidRootPart end
                    end
                end
            end
        end
    end
    return closest
end

