local BG_DEF, BG_CAT = "rbxassetid://100780772234967", "rbxassetid://116530036450269"
local bgCache = nil
local function findBg()
    if bgCache and bgCache.Parent then return bgCache end
    local sg = guiParent():FindFirstChild("WindUI")
    if not sg then return nil end
    local main = sg:FindFirstChild("MainFrame") or sg
    for _, v in ipairs(main:GetDescendants()) do
        if v:IsA("ImageLabel") and (v.Image == BG_DEF or v.Image == BG_CAT) then bgCache = v return v end
        if v:IsA("Frame") and (v.BackgroundImage == BG_DEF or v.BackgroundImage == BG_CAT) then bgCache = v return v end
    end
end
