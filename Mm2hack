local kemlopLoading
do
    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local function getUIParent()
        local ok, p = pcall(function() return gethui and gethui() end)
        if ok and p then return p end
        local ok2, p2 = pcall(function() return game:GetService("CoreGui") end)
        if ok2 and p2 then return p2 end
        local lp2 = Players.LocalPlayer
        return lp2 and lp2:FindFirstChildOfClass("PlayerGui") or lp2:WaitForChild("PlayerGui")
    end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "kemlopLoadingScreen" gui.IgnoreGuiInset = true gui.DisplayOrder = 2000 gui.ResetOnSpawn = false
    local parent = getUIParent()
    if syn and syn.protect_gui then syn.protect_gui(gui) end
    if protect_gui then protect_gui(gui) end
    gui.Parent = parent

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0) bg.BackgroundColor3 = Color3.fromRGB(12, 12, 18) bg.BorderSizePixel = 0 bg.ZIndex = 10 bg.Parent = gui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40) title.Position = UDim2.fromScale(0, 0.5)
    title.BackgroundTransparency = 1 title.Text = "kemlopHud v13"
    title.TextColor3 = Color3.new(1, 1, 1) title.Font = Enum.Font.GothamBold title.TextSize = 30 title.ZIndex = 11 title.Parent = bg

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 24) status.Position = UDim2.fromScale(0, 0.57)
    status.BackgroundTransparency = 1 status.Text = "Запуск..."
    status.TextColor3 = Color3.fromRGB(170, 170, 190) status.Font = Enum.Font.Gotham title.TextSize = 16 status.ZIndex = 11 status.Parent = bg

    local done = false
    kemlopLoading = {
        set = function(p, t) if done then return end status.Text = t or status.Text end,
        finish = function()
            if done then return end done = true
            local ti = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(bg, ti, {BackgroundTransparency = 1}):Play()
            TweenService:Create(title, ti, {TextTransparency = 1}):Play()
            TweenService:Create(status, ti, {TextTransparency = 1}):Play()
            task.delay(0.7, function() pcall(function() gui:Destroy() end) end)
        end,
    }
    task.delay(20, function() kemlopLoading.finish() end)
end
kemlopLoading.set(0.1, "Загрузка...")

