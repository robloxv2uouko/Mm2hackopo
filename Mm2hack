local function touchPart(a, b)
    if not (a and b) then return end
    if firetouchinterest then
        local ok = pcall(function() firetouchinterest(a, b, 0) firetouchinterest(a, b, 1) end)
        if ok then return end
    end
    if firetouchinterest_2 then
        local ok2 = pcall(function() firetouchinterest_2(a, b, 0) firetouchinterest_2(a, b, 1) end)
        if ok2 then return end
    end
    pcall(function() a.CFrame = b.CFrame end)
end
