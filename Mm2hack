local function createFloatingButton(text, variable, defaultPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = defaultPos
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    btn.BackgroundTransparency = 0.2
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Draggable = true -- Можно перетаскивать
    btn.Parent = btnGui
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(50, 50, 60)
    stroke.Thickness = 1.5
    
    -- Логика переключения
    btn.MouseButton1Click:Connect(function()
        S[variable] = not S[variable]
        if S[variable] then
            btn.BackgroundColor3 = Color3.fromRGB(80, 150, 255) -- Синий (вкл)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            stroke.Color = Color3.fromRGB(120, 180, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30) -- Темный (выкл)
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            stroke.Color = Color3.fromRGB(50, 50, 60)
        end
    end)
    return btn
end

