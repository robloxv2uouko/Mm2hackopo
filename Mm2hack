local FarmEnabled, ESPEnabled, AuraEnabled = false, false, false
local NoclipEnabled, RainbowEnabled, AutoJumpEnabled = false, false, false
local FlingEnabled, FlyEnabled = false, false
local FlingRange = 10
local FlySpeed = 60
