local ROLE_COLORS={Murderer=Color3.fromRGB(255,60,60),Sheriff=Color3.fromRGB(60,130,255),Innocent=Color3.fromRGB(80,255,120)}
local ROLE_RU={Murderer="Убийца",Sheriff="Шериф",Innocent="Невиновный"}
local roleCache,getDataRF={},nil

loop(2,function()
    if not(getDataRF and getDataRF.Parent) then getDataRF=RepStorage:FindFirstChild("GetPlayerData",true) end
    if getDataRF and getDataRF:IsA("RemoteFunction") then
        local ok,data=pcall(function() return getDataRF:InvokeServer() end)
        if ok and type(data)=="table" then
            local c={}
            for name,info in pairs(data) do
                if type(info)=="table" and type(info.Role)=="string" then c[tostring(name)]=info.Role end
            end
            roleCache=c
        end
    end
end)

local function normRole(r)
    r=tostring(r):lower()
    if r:find("murder") then return "Murderer" end
    if r:find("sheriff") or r:find("hero") then return "Sheriff" end
    if r:find("innocent") then return "Innocent" end
end
local function scanTools(c)
    if not c then return end
    for _,t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local n=t.Name:lower()
            if n:find("knife") then return "Murderer" end
            if n:find("gun") or n:find("revolver") then return "Sheriff" end
        end
    end
end
local function getRoleRaw(plr)
    local cr=roleCache[plr.Name]
    local n=cr and normRole(cr)
    if n then return n end
    local r=scanTools(plr:FindFirstChildOfClass("Backpack")) or scanTools(plr.Character)
    if r then return r end
    for _,a in ipairs({"Role","role"}) do
        local v=plr:GetAttribute(a) or (plr.Character and plr.Character:GetAttribute(a))
        local nn=v and normRole(v)
        if nn then return nn end
    end
    return "Innocent"
end
local roleMemo={}
local function getRole(plr)
    local m=roleMemo[plr]
    local now=tick()
    if m and now-m[2]<0.5 then return m[1] end
    local r=getRoleRaw(plr)
    roleMemo[plr]=table.pack(r,now)
    return r
end
local function byRole(name) for _,p in ipairs(Players:GetPlayers()) do if p~=lp and getRole(p)==name then return p end end end
local function names()
    local t={}
    for _,p in ipairs(Players:GetPlayers()) do if p~=lp then t[#t+1]=p.Name end end
    return t
end
local function alive(plr) local h=plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") return h and h.Health>0 end

